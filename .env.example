# ============================================
# Onebase 应用 secrets（请复制为 .env 后填入真实值）
# ============================================
# 该文件可以提交到 git，但 .env 已被 .gitignore 忽略。
# 启动前：
#     cp .env.example .env
#     # 填入下面变量的真实值（命令见每条说明）

# ── JWT 签名密钥 ──
# 用于签名 / 校验所有 access token。≥ 16 字符，建议 32+。
# 生成命令：openssl rand -base64 48
JWT_SECRET=请用 openssl rand -base64 48 替换此行

# ── 对称加密主密钥 ──
# 用于加密租户数据库连接密码、OAuth token 等敏感字段。
# 必须为 base64 编码的 32 字节（即解码后正好 32B）。
# 生成命令：openssl rand -base64 32
ENCRYPTION_KEY=请用 openssl rand -base64 32 替换此行

# ── CORS 白名单（可选）──
# 逗号分隔的允许 origin 列表；`*` 表示全部允许（仅开发用）。
# 生产环境应改为类似：https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# ── 对外调用基址 / 网关域名（可选）──
# 运维在网关层新增对外域名后，接口文档展示的调用地址、各处「基址 Base URL」应统一走网关，
# 而不是后端实例的内网 IP:端口。解析优先级（先命中先用）：
#   1. 本变量 PUBLIC_BASE_URL（显式配置，最高优先级；OIDC issuer 亦复用，IDP_ISSUER 更高）
#   2. 反向代理转发头 X-Forwarded-Host + X-Forwarded-Proto（网关反代通常自动带上，多数部署零配置即可）
#   3. 原始 Host 头
# 改网关域名只需改这里并重启后端，**前端无需重新构建**（前端通过 /api/public/config 运行期获取）。
# 示例：PUBLIC_BASE_URL=https://gw.example.com
# PUBLIC_BASE_URL=

# ── 管理库连接串（必填）──
# 用户、租户、角色等管理表所在的 PostgreSQL 数据库；未设置时服务直接 panic。
# 格式：postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>

# ── Webhook 分发限流 / 配置缓存（可选）──
# 每个 DataChangeEvent 会查 management.webhooks；无界并发易在事件风暴时打满管理库连接。
# 同时进行中的 dispatch 数（默认 16）；HTTP 发送不长期占用许可。
# WEBHOOK_DISPATCH_CONCURRENCY=16
# 活跃 webhook 配置缓存秒数（默认 30）；配置变更最多延迟此 TTL 生效。
# WEBHOOK_CONFIG_CACHE_TTL_SECS=30

# ── 租户连接池预算（可选）──
# 单库 API 上限固定 1..=50；同一 (db_host, db_port) 上各库 max_connections 之和默认 ≤ 60。
# TENANT_POOL_GLOBAL_MAX_CONNECTIONS=60
# 运行时覆盖建池 max_connections（设置则完全覆盖 DB 配置；clamp 1..=50）。
# 测试环境可设 30~50，无需改 management.tenant_databases 行；改后需重启进程。
# TENANT_DB_MAX_CONNECTIONS=30
# 运行时覆盖建池 acquire 超时（秒；设置则完全覆盖 DB connection_timeout；clamp 1..=600）。
# 默认新建库 connection_timeout=8；存量库仍读 DB 列，可用本 env 或改库后 pool-reset 生效。
# TENANT_DB_ACQUIRE_TIMEOUT=8
# 工作流 Postgres 节点 statement_timeout（毫秒，默认 30000）。
# WORKFLOW_DB_STATEMENT_TIMEOUT_MS=30000

# ── AIO 容器内嵌 Postgres 调优（仅 Dockerfile.aio / entrypoint.sh，可选）──
# 每次启动幂等写入 postgresql.conf。生产持续 OOM 时应评估把 PG 拆出独立部署。
# AIO_PG_MAX_CONNECTIONS=120
# AIO_PG_SHARED_BUFFERS=256MB
# AIO_PG_WORK_MEM=4MB

# ── 启动期自动迁移（推荐测试/预发保持开启）──
# 主进程启动时执行 src/migrate.rs 全量序列（幂等，多实例有 advisory lock）。
# 缺省 on；一般不必再单独 `cargo run --bin migrate_all`（那会多编一个 bin，很慢）。
# 仅当 CI/CD 要做 gated 迁移时再设 AUTO_MIGRATE=off。
# AUTO_MIGRATE=on

# ── 开通项目时的 PG admin 凭据（可选）──
# 默认使用 DATABASE_URL 的 user/password 在同一台 PG 上 CREATE DATABASE。
# 若管理库账号无 CREATEDB 权限，可单独配置具备建库权限的连接串：
# PROVISION_PG_URL=postgresql://postgres:<password>@<host>:<port>/postgres
#
# 未设置时，服务会从 DATABASE_URL 派生（同 user/password/host，库名改为 postgres）。

# ── P1.1：每项目独立 PG 登录角色（可选）──
# 开通本地 PG 项目时为每个库创建专属角色 {db}_app，仅授予该库权限，运行期不再用 admin。
#   auto（默认）：尝试创建；admin 无 CREATEROLE 权限时回退 admin 凭据并告警
#   require     ：强制；建角色失败则回滚并报错
#   off         ：关闭，沿用 admin 凭据（旧行为）
# PROVISION_PER_PROJECT_ROLE=auto

# ── P3：运维 Provisioner Webhook（可选）──
# 配置后开通向导会出现「运维自动开通」；由外部 HTTP 服务创建 PG 并返回连接信息。
# PROVISION_WEBHOOK_URL=http://127.0.0.1:9090/provision
# PROVISION_WEBHOOK_TOKEN=dev-token
# PROVISION_WEBHOOK_TIMEOUT_SECS=120
# PROVISION_WEBHOOK_DEPROVISION_URL=http://127.0.0.1:9090/deprovision
# PROVISION_WEBHOOK_POLL_INTERVAL_SECS=5
# PROVISION_WEBHOOK_POLL_MAX_SECS=600
# 本地 mock：python3 examples/provisioner-webhook/mock_server.py
# 异步联调：MOCK_ASYNC=1 python3 examples/provisioner-webhook/mock_server.py

# ── 后端监听地址 / 端口（可选）──
# HOST 默认 127.0.0.1（仅本机访问）；容器或对外暴露时改为 0.0.0.0。
# PORT 默认 3000。
HOST=127.0.0.1
PORT=3000

# ── 日志级别（可选）──
# 由 tracing-subscriber 的 EnvFilter 解析。未设置时默认 `info,onebase=debug,sqlx=info`。
# 示例：开发用 debug，生产用 warn,onebase=info。
RUST_LOG=info,onebase=debug,sqlx=info

# ── 日志落盘（可选，二选一）──
# 不设置：仅 stdout（本地 cargo run / `docker logs` / `kubectl logs` 直接看）。
# 设置 LOG_DIR：在该目录下按天滚动写 `onebase.log.YYYY-MM-DD`，stdout 仍同步输出。
# 设置 LOG_FILE：单文件追加写（自动建父目录），不滚动；适合开发/排障，生产建议交给 logrotate。
# 两者同时设置时，LOG_DIR 优先。
# LOG_DIR=/var/log/onebase
# LOG_FILE=./onebase.log

# ── 统一执行日志保留（可选）──
# 系统把工作流 / 定时任务 / API 等各类执行汇聚到 management.execution_index（执行索引）
# 与 management.execution_logs（细节日志），后台任务按下列阈值滚动清理。
# 细节日志保留小时数（默认 24，即"保留一天但详细"）：
# EXEC_LOG_RETENTION_HOURS=24
# 执行索引保留天数（行小量少，默认 7）：
# EXEC_INDEX_RETENTION_DAYS=7
# 权威 run 表保留天数（management.workflow_runs / scheduled_task_runs，含完整节点输出，体积大）：
# 默认 7；会被强制 ≥ EXEC_INDEX_RETENTION_DAYS，避免索引窗口内点详情回查不到 run。
# EXEC_RUNS_RETENTION_DAYS=7
# 生产建议：索引 + 权威 run 表只保留 3 天（需同时设置；重启后生效）：
# EXEC_INDEX_RETENTION_DAYS=3
# EXEC_RUNS_RETENTION_DAYS=3
# 清理任务运行间隔秒数（默认 3600，每小时一次）：
# EXEC_LOG_CLEANUP_INTERVAL_SECS=3600

# ── 工作流超时（可选）──
# 解决「AI/LLM 等长耗时 HTTP 节点在默认超时被强杀」。所有超时层均可配置，并可整体关闭。
# 生效优先级：节点显式 timeout_secs > 下列环境变量 > 内置默认。
#
# 总开关：设为 1/true/on 后，工作流整体超时与 HTTP 节点默认超时全部关闭（不限时长）。
# 节点仍可单独设 timeout_secs 自行限制；适合"彻底不要再超时"的场景。
# 注意：关闭后若进程崩溃，残留的 running 记录要等 WORKFLOW_STALE_GRACE_SECS 才被收口。
# WORKFLOW_DISABLE_TIMEOUT=1
#
# 工作流整体默认超时（毫秒）。仅当某工作流的 timeout_ms<=0 时采用；缺省 300000（5 分钟）。
# WORKFLOW_DEFAULT_TIMEOUT_MS=300000
#
# HTTP 节点未显式配置超时时的默认值（秒）。缺省 120；设 0 表示该默认不限（由整体超时兜底）。
# WORKFLOW_HTTP_DEFAULT_TIMEOUT_SECS=120
#
# code(Lua) 节点单节点执行的墙钟上限（毫秒）。缺省 30000；设 0 表示不限（慎用）。
# 单个 code 节点串行处理多行 + 每行调 LLM/长耗时 HTTP（如 AI 关单逐单调 DeepMind）时，
# 30s 易被强杀，按需调大；注意它不受 WORKFLOW_DISABLE_TIMEOUT 影响（防死循环占死线程的最后一道闸），
# 且调大后仍受工作流整体 timeout_ms 兜底约束。
# WORKFLOW_LUA_TIMEOUT_MS=180000
#
# ── 工作流 JavaScript code 节点 ──
# 默认开启（未设置即启用）；设为 false/0/no/off 可关闭。开启后 code 节点可设
# language=javascript|js 执行 Node.js 脚本。宿主机需安装 node/npm；缺省超时与 Lua 对齐（30s）。
# WORKFLOW_JS_CODE_ENABLED=true
#
# JS 单节点执行墙钟上限（毫秒）。缺省 30000；设 0 表示回退缺省值。
# WORKFLOW_JS_TIMEOUT_MS=30000
#
# 工作流级 npm install 超时（毫秒）。缺省 300000（5 分钟）。
# WORKFLOW_NPM_INSTALL_TIMEOUT_MS=300000
#
# JS 依赖安装根目录。缺省为进程 cwd 下 workflow_deps/{workflow_id}/javascript/。
# WORKFLOW_DEPS_DIR=
#
# npm registry 覆盖（可选）。设置后 npm ci|install 追加 --registry。
# WORKFLOW_NPM_REGISTRY=
#
# node / npm 可执行文件路径（可选）。缺省在 PATH 中查找 node、npm。
# WORKFLOW_NODE_BIN=
# WORKFLOW_NPM_BIN=
#
# JS 运行时 shim（index.js）路径。本地开发缺省用源码树里的 js-runtime；
# 容器/打包部署必须显式指向镜像内位置（镜像已设为 /app/js-runtime/...）。
# WORKFLOW_JS_RUNTIME=
#
# JS 子进程沙盒：缺省 auto（系统有 bwrap 则启用 bubblewrap 隔离）；direct|none|raw 关闭 bwrap。
# WORKFLOW_JS_SANDBOX=
#
# ── 工作流 Python code 节点 ──
# 默认开启（未设置即启用）；设为 false/0/no/off 可关闭。开启后 code 节点可设
# language=python|py 执行 CPython 脚本。宿主机需安装 python3/pip；缺省超时与 Lua 对齐（30s）。
# WORKFLOW_PY_CODE_ENABLED=true
#
# Python 单节点执行墙钟上限（毫秒）。缺省 30000；设 0 表示回退缺省值。
# WORKFLOW_PY_TIMEOUT_MS=30000
#
# python3 可执行文件路径（可选）。缺省在 PATH 中查找 python3。
# WORKFLOW_PYTHON_BIN=
# pip 可执行文件路径（可选）。缺省用「与执行同一解释器」的 `python3 -m pip`，
# 保证安装与运行 ABI 一致；设置后则直接用该 pip 二进制安装。
# WORKFLOW_PIP_BIN=
#
# Python 运行时 shim 目录（含 onebase_host.py）。本地开发缺省用源码树里的
# py-runtime；容器/打包部署必须显式指向镜像内位置（镜像已设为 /app/py-runtime/...）。
# WORKFLOW_PY_RUNTIME=
#
# 工作流级 pip install 超时（毫秒）。缺省 300000（5 分钟）。
# WORKFLOW_PIP_INSTALL_TIMEOUT_MS=300000
#
# pip index-url 覆盖（可选）。设置后 pip install 追加 --index-url。
# WORKFLOW_PIP_INDEX_URL=
#
# Python 依赖与 JS 共用 WORKFLOW_DEPS_DIR：workflow_deps/{workflow_id}/python/site-packages/。
#
# Python 子进程沙盒：缺省 auto（系统有 bwrap 则启用 bubblewrap 隔离）；direct|none|raw 关闭 bwrap。
# WORKFLOW_PY_SANDBOX=
#
# 残留 running 收口阈值（秒）。超过该时长仍 running 的执行会被自检置为 failed。
# 缺省 600；开启 WORKFLOW_DISABLE_TIMEOUT 时缺省自动放大到 86400（24h）。
# WORKFLOW_STALE_GRACE_SECS=600
#
# ── 网关 API Key 只读护栏（DB 写维度）──
# endpoint 触发工作流时，按请求所带网关 cr_ key 的 permissions 判读写：只读 key（无
# INSERT/UPDATE/DELETE scope）触发的工作流里，DB 写节点（db_execute / db_transaction /
# foreach）按下面档位处理；db_query 走 READ ONLY 事务；http/email/sse 不受影响。
# 判权口径与 Auto API 网关（rbac_middleware）完全一致（单一事实来源）。
#   off      = 完全不启用（等于历史行为）
#   log_only = 只算不拦，命中写节点仅打审计日志（target=authz），用于灰度观测（缺省）
#   enforce  = 真正拦截：写节点直接失败，整条工作流中断并返回 HTTP 403
# 缺省 log_only：合并即产生审计日志、不改现网行为；确认无误后再切 enforce。
#
# enforce 是**硬失败**，不是跳过写操作后放行。写节点被静默跳过时，依赖它输出的下游
# 节点会拿着"0 行受影响"继续跑，把一次本该被拒的调用变成看起来成功、实则数据不一致
# 的结果，所以宁可整条中断。该失败也不可被节点的 allow_failure 容错吞掉。
# 工作流若开了 graceful_error_response，仍按其语义返回 HTTP 200 + {ok:false,error}。
#
# 只有**显式声明**过权限且不含任何写动作的 key 才算只读；permissions 为空对象或 NULL
# 时无从判断意图，一律放行不拦（建表默认值是全权限，空值属异常数据）。
# WORKFLOW_APIKEY_RW_GUARD=log_only

# ── Redis 连接地址（可选）──
# 用于缓存、限流、多实例间的实时事件 / SSE Pub/Sub。默认 redis://127.0.0.1:6379。
# 多实例部署时必须指向共享的 Redis 实例，否则跨 pod 的 WebSocket / SSE 推送会静默丢失。
REDIS_URL=redis://127.0.0.1:6379
# Redis 不可用时是否启动失败（fail-fast）。true / 1 / yes 生效；默认 false（仅 warn 并降级）。
# 生产 / 多副本务必设为 true，避免 SSE / 实时推送在无 Redis 桥接下静默运行。
# REQUIRE_REDIS=true

# ── 只读副本看护（可选）──
# 后端会启动一个后台任务，定期探活已加载的副本连接池。
# 连续探活失败 / 复制延迟超阈值 / 非 standby，会被**运行时旁路**：
# 暂时从读流量轮询中摘除（不写库、不修改 is_active）；副本恢复健康会自动重新上线。
#
# 探活间隔（秒）
REPLICA_WATCHDOG_INTERVAL_SECS=15
# 单次探活超时（秒）
REPLICA_WATCHDOG_TIMEOUT_SECS=3
# 连续失败多少次后触发旁路
REPLICA_WATCHDOG_MAX_FAIL=2
# 复制延迟阈值（秒），超过即视为本次失败；设为 `off` 关闭延迟检查
REPLICA_WATCHDOG_LAG_THRESHOLD_SECS=60
# 是否要求副本处于 standby（pg_is_in_recovery() = true）；
# 关掉后可把可写库挂为读节点（不建议）
REPLICA_WATCHDOG_REQUIRE_STANDBY=true

# ── SSE 心跳 / 优雅断开（可选）──
# 具名心跳事件（event: heartbeat）间隔（秒），默认 10（对齐旧版 Go sq_push_server）。
# SSE_HEARTBEAT_SECS=10
# 全局优雅断开兜底：默认关（不配置即永不自动断开）。仅作为 /events/:slug 节点
# 未显式配置时的回退，以及通用 /sse 端点的默认。到点先发 event: exit 再断开。
# 节点级 graceful_close_enabled / graceful_close_seconds 优先于此全局值。
# SSE_GRACEFUL_CLOSE_ENABLED=false
# SSE_GRACEFUL_CLOSE_MINUTES=25

# ── Google/FCM Service Account 私钥隐藏（工作流 google.sa_assertion 用）──
# 工作流 Lua 里只调 google.sa_assertion(project, scope)：宿主用
#   hex(sha256(project + tenant_id + FCM_KEY_SALT))
# 派生出 K8s 密钥文件名，读取挂载的 Service Account JSON 并签出 RS256 JWT，
# 私钥永不进 Lua/DB/管理页/日志。
#
# 保密盐（机密！与 ENCRYPTION_KEY 同级）：派生名不可猜的唯一来源，缺失则 sa_assertion 拒签。
# 由 K8s Secret 注入进程 env（示例：Secret onebase-fcm-key-salt 的 key-salt → 容器 env
# FCM_KEY_SALT）。切勿写进 git / 明文配置。生成命令：openssl rand -base64 32
# FCM_KEY_SALT=请用 openssl rand -base64 32 替换此行
#
# SA JSON 挂载目录（非敏感，可明文）。运维用 `fcm_secret_name` 工具算出 <hex>.json 文件名，
# 把对应 project 的 Service Account JSON 放到该目录下。默认 /app/secrets/fcm。
# FCM_SECRETS_DIR=/app/secrets/fcm
