# ============================================
# OneBase 前端（Next.js）配置（复制为 .env.local 后按需修改）
# ============================================
# 只有以 NEXT_PUBLIC_ 开头的变量会被打进浏览器 bundle，且在「构建期」内联，
# 修改后需重新 build / 重启 dev server 才能生效。

# ── 后端地址（可选）──
# 不设置时，next.config.js 会回退读取项目根目录 ../.env 的 HOST/PORT，
# 再兜底到 http://127.0.0.1:3000。生产 / Docker 建议显式设置。
# NEXT_PUBLIC_API_URL=https://api.example.com

# ── DeepWork AI 助手嵌入地址（可选）──
# AI 助手面板内嵌的 Embed 页面完整地址（含 projectId）。
# postMessage 的 targetOrigin / 来源校验会自动从该地址推导 origin。
# 不设置时默认：https://deepwork.mindoffice.cn/embed/onebase
NEXT_PUBLIC_DEEPWORK_EMBED_URL=https://deepwork.mindoffice.cn/embed/onebase

# ── 是否启用 AI 助手（可选）──
# 取值 0 / false / off / no 关闭整个 AI 助手（不渲染悬浮按钮与面板）；
# 其余值或不设置视为启用。
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=true

# ── DeepWork Embed 项目级 API Key（可选，启用免跳转登录）──
# 配置后，AI 助手在 iframe 加载后通过 embed:set-access-token 以 postMessage 下发该 key，
# 实现免跳转登录（凭证不进 URL，避免明文出现在地址栏/历史/录屏）；不设置则回退到原登录方式。
# 注意：NEXT_PUBLIC_* 会被内联进前端 bundle，属公开值，真实 key 建议放到 .env.local（已被 git 忽略）。
# NEXT_PUBLIC_DEEPWORK_EMBED_API_KEY=dw_xxxxxxxx.yyyyyyyy